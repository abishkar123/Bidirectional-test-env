<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Bidirectional Platform</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var currentPath = Context.Request.Path.Value ?? "";
    bool IsActive(string prefix) =>
        prefix == "/" ? currentPath == "/" : currentPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
}
<div class="app-shell">

    <aside class="sidebar">
        <a class="sidebar-brand" asp-page="/Index">
            <i class="bi bi-arrow-left-right"></i>
            Bidirectional
        </a>
        <nav class="sidebar-nav">
            <a class="sidebar-nav-link @(IsActive("/") ? "active" : "")" asp-page="/Index">
                <i class="bi bi-speedometer2"></i>Dashboard
            </a>
            <a class="sidebar-nav-link @(IsActive("/Releases") ? "active" : "")" asp-page="/Releases/Index">
                <i class="bi bi-rocket"></i>Releases
            </a>
            <a class="sidebar-nav-link @(IsActive("/Policy") ? "active" : "")" asp-page="/Policy/Index">
                <i class="bi bi-shield-check"></i>Policy
            </a>
            <a class="sidebar-nav-link @(IsActive("/Scans") ? "active" : "")" asp-page="/Scans/Index">
                <i class="bi bi-bug"></i>Scans
            </a>
            <a class="sidebar-nav-link @(IsActive("/Sbom") ? "active" : "")" asp-page="/Sbom/Index">
                <i class="bi bi-file-earmark-code"></i>SBOM
            </a>
            <a class="sidebar-nav-link @(IsActive("/Audit") ? "active" : "")" asp-page="/Audit/Index">
                <i class="bi bi-journal-text"></i>Audit Log
            </a>
        </nav>
        <div class="sidebar-footer">
            <i class="bi bi-circle-fill text-success me-1" style="font-size:.45rem;vertical-align:middle"></i>
            @(System.Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") ?? "Development")
        </div>
    </aside>

    <div class="main-wrapper">
        <main class="page-body">
            @RenderBody()
        </main>
        <footer class="app-footer">
            &copy; @DateTime.UtcNow.Year Bidirectional &mdash; Regulated Platform Dashboard
        </footer>
    </div>

</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
