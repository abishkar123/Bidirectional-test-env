@page
@model Bidirectional.Web.Pages.Audit.AuditModel
@{
    ViewData["Title"] = "Audit Log";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 page-title"><i class="bi bi-journal-text me-2 text-primary"></i>Audit Log</h1>
    <span class="text-muted small">@Model.Entries.Count entries &mdash; @Model.LoadedAt.ToString("HH:mm:ss 'UTC'")</span>
</div>

@if (Model.Error is not null)
{
    <div class="alert alert-warning d-flex align-items-center">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <span>@Model.Error</span>
    </div>
}

<div class="d-flex gap-2 mb-3 flex-wrap align-items-center">
    <input type="text" id="auditSearch" class="form-control form-control-sm"
           style="max-width:260px" placeholder="Search entries…" />
    <select id="auditFilter" class="form-select form-select-sm" style="max-width:180px">
        <option value="">All containers</option>
        <option value="release-audit">Releases</option>
        <option value="sbom-archive">SBOMs</option>
        <option value="scan-results">Scans</option>
        <option value="provenance-archive">Provenance</option>
    </select>
    <span id="auditCount" class="text-muted small ms-1"></span>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0" id="auditTable">
            <thead class="table-light">
                <tr>
                    <th>Timestamp (UTC)</th>
                    <th>Type</th>
                    <th>Entry</th>
                    <th class="text-end">Size</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Entries)
                {
                    var (badgeBg, badgeText) = e.Container switch
                    {
                        "release-audit"      => ("primary", "primary"),
                        "sbom-archive"       => ("info",    "info"),
                        "scan-results"       => ("warning", "warning"),
                        "provenance-archive" => ("secondary", "secondary"),
                        _                    => ("light",   "secondary")
                    };
                    <tr data-container="@e.Container" data-name="@e.DisplayName.ToLowerInvariant()">
                        <td class="text-muted small">@e.Timestamp.ToString("dd MMM yyyy HH:mm")</td>
                        <td>
                            <span class="badge bg-@badgeBg bg-opacity-10 text-@badgeText border border-@badgeBg border-opacity-25 fw-normal">
                                @e.ContainerLabel
                            </span>
                        </td>
                        <td><code class="small">@e.DisplayName</code></td>
                        <td class="text-end text-muted small">@(e.SizeBytes > 0 ? ByteFormatter.Format(e.SizeBytes) : "—")</td>
                    </tr>
                }
                @if (!Model.Entries.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-5">
                            <i class="bi bi-inbox d-block fs-3 mb-2 opacity-25"></i>
                            No audit entries found. Run a deployment to generate audit trail data.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var search  = document.getElementById('auditSearch');
    var filter  = document.getElementById('auditFilter');
    var counter = document.getElementById('auditCount');
    var rows    = Array.from(document.querySelectorAll('#auditTable tbody tr[data-container]'));

    function applyFilters() {
        var q         = search.value.toLowerCase().trim();
        var container = filter.value;
        var visible   = 0;
        rows.forEach(function (row) {
            var matchSearch = !q || row.dataset.name.includes(q);
            var matchFilter = !container || row.dataset.container === container;
            var show = matchSearch && matchFilter;
            row.style.display = show ? '' : 'none';
            if (show) visible++;
        });
        counter.textContent = (q || container) ? visible + ' shown' : '';
    }

    search.addEventListener('input', applyFilters);
    filter.addEventListener('change', applyFilters);
})();
</script>
}
